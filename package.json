{
  "name": "kyrelix-site",
  "private": true,
  "version": "0.0.0",
  "description": "Kyrelix landing page",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts && npm run check:seo",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:types": "tsc -p tsconfig.tests.json",
    "check:seo": "tsx scripts/check-seo.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^12.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
